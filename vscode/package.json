{
  "name": "plandown-vscode",
  "displayName": "Plandown",
  "publisher": "lmauricius",
  "version": "0.1.0",
  "description": "Plandown task manager inside VSCode: task tree, task tabs, link graph and time view over a folder of Markdown files.",
  "icon": "icon.png",
  "galleryBanner": { "color": "#0f2e2c", "theme": "dark" },
  "repository": { "type": "git", "url": "https://github.com/LMauricius/plandown.git", "directory": "vscode" },
  "engines": { "vscode": "^1.90.0" },
  "main": "dist/extension.js",
  "activationEvents": ["workspaceContains:**/plandown-format.md", "onWebviewPanel:plandown.view"],
  "contributes": {
    "configuration": {
      "title": "Plandown",
      "properties": {
        "plandown.searchDepth": { "type": "integer", "default": 3, "minimum": 0, "description": "How many folders deep below a workspace folder to look for plandown-format.md." }
      }
    },
    "languages": [
      { "id": "plandown", "aliases": ["Plandown"], "extensions": [".plandown.md"], "filenames": ["plandown-format.md"], "configuration": "./language-configuration.json",
        "icon": { "light": "./dist/sign.svg", "dark": "./dist/sign.svg" } }
    ],
    "grammars": [{ "language": "plandown", "scopeName": "text.html.markdown.plandown", "path": "./syntaxes/plandown.tmLanguage.json" }],
    "customEditors": [
      { "viewType": "plandown.own", "displayName": "Plandown", "selector": [{ "filenamePattern": "*.plandown.md" }], "priority": "default" },
      { "viewType": "plandown.file", "displayName": "Plandown (any Markdown file)", "selector": [{ "filenamePattern": "*.md" }], "priority": "option" },
      { "viewType": "plandown.task", "displayName": "Plandown Task", "selector": [{ "filenamePattern": "**/.plandown-tasks/*" }], "priority": "option" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "plandown", "title": "Plandown", "icon": "dist/symbolic.svg" }]
    },
    "views": {
      "plandown": [{ "id": "plandown.tree", "name": "Tasks" }]
    },
    "commands": [
      { "command": "plandown.create", "title": "New Task", "category": "Plandown", "icon": "$(add)" },
      { "command": "plandown.createGroup", "title": "New Group", "category": "Plandown", "icon": "$(new-folder)" },
      { "command": "plandown.graph", "title": "Show Graph", "category": "Plandown", "icon": "$(type-hierarchy)" },
      { "command": "plandown.time", "title": "Show Timeline", "category": "Plandown", "icon": "$(clock)" },
      { "command": "plandown.filter", "title": "Filter Tasks", "category": "Plandown", "icon": "$(filter)" },
      { "command": "plandown.clearFilter", "title": "Clear Filter", "category": "Plandown", "icon": "$(clear-all)" },
      { "command": "plandown.openPinned", "title": "Open in New Tab", "category": "Plandown" },
      { "command": "plandown.openNode", "title": "Open Group", "category": "Plandown" },
      { "command": "plandown.openInPlandown", "title": "Open in Plandown", "category": "Plandown" },
      { "command": "plandown.openBrowser", "title": "Open in Browser", "category": "Plandown", "icon": "$(globe)" },
      { "command": "plandown.refresh", "title": "Rescan Workspace", "category": "Plandown", "icon": "$(refresh)" }
    ],
    "keybindings": [
      { "key": "alt+enter", "command": "plandown.openInPlandown", "when": "explorerViewletFocus && !inputFocus && resourcePath in plandown.paths" },
      { "key": "alt+left", "mac": "cmd+[", "command": "workbench.action.navigateBack", "when": "activeCustomEditorId == 'plandown.task' || activeCustomEditorId == 'plandown.file' || activeWebviewPanelId == 'plandown.view'" },
      { "key": "alt+right", "mac": "cmd+]", "command": "workbench.action.navigateForward", "when": "activeCustomEditorId == 'plandown.task' || activeCustomEditorId == 'plandown.file' || activeWebviewPanelId == 'plandown.view'" }
    ],
    "menus": {
      "commandPalette": [{ "command": "plandown.openPinned", "when": "false" }, { "command": "plandown.openNode", "when": "false" }, { "command": "plandown.openInPlandown", "when": "false" }],
      "explorer/context": [{ "command": "plandown.openInPlandown", "group": "navigation@9", "when": "resourcePath in plandown.paths" }],
      "editor/title": [
        { "command": "plandown.graph", "group": "navigation@1", "when": "plandown.active" },
        { "command": "plandown.time", "group": "navigation@2", "when": "plandown.active" },
        { "command": "plandown.create", "group": "navigation@3", "when": "plandown.active" }
      ],
      "view/title": [
        { "command": "plandown.create", "group": "navigation@1", "when": "view == plandown.tree" },
        { "command": "plandown.createGroup", "group": "navigation@2", "when": "view == plandown.tree" },
        { "command": "plandown.filter", "group": "navigation@3", "when": "view == plandown.tree && !plandown.filtered" },
        { "command": "plandown.clearFilter", "group": "navigation@3", "when": "view == plandown.tree && plandown.filtered" },
        { "command": "plandown.refresh", "group": "navigation@4", "when": "view == plandown.tree" },
        { "command": "plandown.openBrowser", "group": "navigation@5", "when": "view == plandown.tree" }
      ],
      "view/item/context": [
        { "command": "plandown.create", "group": "inline@1", "when": "view == plandown.tree" },
        { "command": "plandown.createGroup", "group": "inline@2", "when": "view == plandown.tree && viewItem =~ /^node/" },
        { "command": "plandown.openPinned", "group": "navigation@1", "when": "view == plandown.tree && viewItem =~ /^(task|node|nodeTask)$/" }
      ]
    }
  },
  "scripts": {
    "build": "tsc && node -e \"for (const f of ['symbolic.svg', 'sign.svg']) require('fs').copyFileSync('../media/' + f, 'dist/' + f)\""
  },
  "dependencies": {
    "plandown": "file:.."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.90.0",
    "typescript": "^5.9.0"
  }
}
